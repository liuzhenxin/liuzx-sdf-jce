<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.liuzx</groupId>
    <artifactId>liuzx-sdf-jce</artifactId>
    <version>1.1.4-SNAPSHOT</version>

    <name>liuzx-sdf-jce</name>
    <description>GM/T 0018-2012 SDF hardware Java Cryptography Extension (JCE) Provider.
        Provides SM2/SM3/SM4/RSA/EdDSA and hardware SecureRandom via JNA.</description>
    <url>https://github.com/liuzhenxin/liuzx-sdf-jce</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>liuzhenxin</id>
            <name>liuzhenxin</name>
            <email>liuzhenxin1977@gmail.com</email>
            <url>https://github.com/liuzhenxin</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:liuzhenxin/liuzx-sdf-jce.git</connection>
        <developerConnection>scm:git:git@github.com:liuzhenxin/liuzx-sdf-jce.git</developerConnection>
        <url>https://github.com/liuzhenxin/liuzx-sdf-jce</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/liuzhenxin/liuzx-sdf-jce/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>org.liuzx.jce.demo.Main</main.class>
        <skipTests>true</skipTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.10.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Copy all dependencies to target/lib -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Configure the main JAR's manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- 不发 Class-Path：Central 使用方加载时 JCE 框架只验证 provider jar 本身，
                                 jna/gson 作为普通 Maven 依赖由使用方解析。本地便携分发用 -cp 方式不受影响。 -->
                            <addClasspath>false</addClasspath>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- 3. Sign the main JAR (not the fat jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>sign</id>
                        <phase>package</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- By default, this signs the main artifact, which is what we want -->
                            <verbose>true</verbose>
                            <keystore>${project.basedir}/keystore.jks</keystore>
                            <alias>dayou</alias>
                            <storepass>123456</storepass>
                            <keypass>123456</keypass>
                            <tsa>http://timestamp.sectigo.com</tsa>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                4. Sign the dependency jars copied to target/lib.
                JCE 框架(JarVerifier)不仅验证 provider 主 jar，还会沿 manifest 的
                Class-Path 逐个验证依赖 jar。若依赖 jar 未签名，运行时 Cipher/Mac/
                KeyGenerator 会抛 "JCE cannot authenticate the provider LiuZX"。
                故用同一证书(jarsigner 每次只能签一个 jar)逐个签名。
                注意：若调整依赖版本，需同步更新这里的文件名。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <signjar jar="${project.build.directory}/lib/jna-5.10.0.jar"
                                         alias="dayou"
                                         storepass="123456"
                                         keypass="123456"
                                         keystore="${project.basedir}/keystore.jks"
                                         tsaurl="http://timestamp.sectigo.com"
                                         lazy="true"/>
                                <signjar jar="${project.build.directory}/lib/gson-2.9.0.jar"
                                         alias="dayou"
                                         storepass="123456"
                                         keypass="123456"
                                         keystore="${project.basedir}/keystore.jks"
                                         tsaurl="http://timestamp.sectigo.com"
                                         lazy="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        发布到 Maven Central (Sonatype Central Portal) 专用 profile。
        用法：mvn clean deploy -Prelease,gpg-signing -DskipTests=true
        前置：域名 liuzx.org 已在 Central Portal 验证；settings.xml 配好
              <server id="central">(User Token) 与 gpg.keyname / gpg.passphrase。
        GPG 签名会覆盖主 jar、-sources.jar、-javadoc.jar 及 .pom。
    -->
    <profiles>
        <profile>
            <id>shudun-it</id>
            <properties>
                <skipTests>false</skipTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>2.22.2</version>
                        <configuration>
                            <skipTests>false</skipTests>
                            <includes>
                                <include>**/*ShudunIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Attach -sources.jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Attach -javadoc.jar (JDK 25 + source/target 1.8: source=8, doclint=none) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <source>8</source>
                                    <doclint>none</doclint>
                                    <failOnWarnings>false</failOnWarnings>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG-sign main jar, -sources.jar, -javadoc.jar and the .pom -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <keyname>${gpg.keyname}</keyname>
                                    <passphrase>${gpg.passphrase}</passphrase>
                                    <gpgArguments>
                                        <arg>--batch</arg>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Publish to Sonatype Central Portal on mvn deploy -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

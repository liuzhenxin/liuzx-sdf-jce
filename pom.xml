<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.liuzx</groupId>
    <artifactId>liuzx-sdf-jce</artifactId>
    <version>1.1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>org.liuzx.jce.demo.Main</main.class>
        <skipTests>true</skipTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.10.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Copy all dependencies to target/lib -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Configure the main JAR's manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- 3. Sign the main JAR (not the fat jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>sign</id>
                        <phase>package</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- By default, this signs the main artifact, which is what we want -->
                            <verbose>true</verbose>
                            <keystore>${project.basedir}/keystore.jks</keystore>
                            <alias>dayou</alias>
                            <storepass>123456</storepass>
                            <keypass>123456</keypass>
                            <tsa>http://timestamp.digicert.com</tsa>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                4. Sign the dependency jars copied to target/lib.
                JCE 框架(JarVerifier)不仅验证 provider 主 jar，还会沿 manifest 的
                Class-Path 逐个验证依赖 jar。若依赖 jar 未签名，运行时 Cipher/Mac/
                KeyGenerator 会抛 "JCE cannot authenticate the provider LiuZX"。
                故用同一证书(jarsigner 每次只能签一个 jar)逐个签名。
                注意：若调整依赖版本，需同步更新这里的文件名。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <signjar jar="${project.build.directory}/lib/jna-5.10.0.jar"
                                         alias="dayou"
                                         storepass="123456"
                                         keypass="123456"
                                         keystore="${project.basedir}/keystore.jks"
                                         tsaurl="http://timestamp.digicert.com"
                                         lazy="true"/>
                                <signjar jar="${project.build.directory}/lib/gson-2.9.0.jar"
                                         alias="dayou"
                                         storepass="123456"
                                         keypass="123456"
                                         keystore="${project.basedir}/keystore.jks"
                                         tsaurl="http://timestamp.digicert.com"
                                         lazy="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
